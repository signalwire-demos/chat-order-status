SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SPACE=your-space.signalwire.com

# Public base URL of this service. The browser derives /chat, /chat/handoff,
# /chat/escalate and /chat/say from it.
PUBLIC_URL=https://your-host.example.com

# Publishable key the page presents. Safe to ship in the page: it names no
# credential, and the gateway's caps bound what it can cost.
CHAT_PUBLIC_KEY=demo-key

# HMAC secret for signing conversation handles. Set this in production or
# handles stop verifying across a restart or a second worker.
CHAT_HANDLE_SECRET=

# Comma separated. localhost is always allowed.
ALLOWED_ORIGINS=
